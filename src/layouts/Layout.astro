    {!import.meta.env.DEV && (
      <script
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token":"9d0ab7a9ea5545c4907a9b53b4082f5e"}'
        fetchpriority="low"
      ></script>
    )}
