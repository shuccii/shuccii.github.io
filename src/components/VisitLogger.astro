---
// 自分だけが見る軽量アクセスログ(集計は合言葉付きの /visits で見る)。
// 保存するのは、ページのパス、IP から引いた粗い地域と回線の提供元、参照元のドメイン、
// 端末・ブラウザ・OS の種類、言語、再訪かどうか、滞在秒数。
// IP アドレスそのもの、User-Agent の原文、参照元の URL 全体、個人を追跡する識別子は保存しない。
// 送信先は自分の Supabase(supabase/visits.sql の record_site_visit)。
---

<script>
  import { readStorage, writeStorage } from "../lib/storage";
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY =
    import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ||
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  type Geo = {
    country: string | null;
    country_code: string | null;
    region: string | null;
    region_code: string | null;
    city: string | null;
    network: string | null;
    asn: number | null;
  };

  type Client = {
    device: "mobile" | "tablet" | "desktop";
    browser: string;
    os: string;
  };

  const GEO_CACHE_KEY = "visit-geo-v2";
  const GEO_CACHE_MS = 12 * 60 * 60 * 1000;
  const CLIENT_KEY = "visit-client-key";
  // 再訪の判定用。前回このブラウザで開いた時刻だけをブラウザ内に置き、サーバには送らない。
  const LAST_SEEN_KEY = "visit-last-seen";
  const SESSION_KEY = "visit-session";
  const LOCAL_HOSTS = new Set(["localhost", "127.0.0.1", "[::1]", ""]);

  // 追跡拒否(Do Not Track / Global Privacy Control)を出しているブラウザでは記録しない。
  function optedOut(): boolean {
    const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
    return nav.doNotTrack === "1" || nav.globalPrivacyControl === true;
  }

  function clientKey(): string {
    // 連投制限のためだけのランダムな値。サーバ側ではハッシュにして保持する。
    let key = readStorage("local", CLIENT_KEY);
    if (!key) {
      key = crypto.randomUUID();
      writeStorage("local", CLIENT_KEY, key);
    }
    return key;
  }

  function cachedGeo(): Geo | null {
    const raw = readStorage("local", GEO_CACHE_KEY);
    if (!raw) return null;
    try {
      const parsed = JSON.parse(raw) as { at: number; geo: Geo };
      if (Date.now() - parsed.at > GEO_CACHE_MS) return null;
      return parsed.geo;
    } catch {
      return null;
    }
  }

  function text(value: unknown): string | null {
    return typeof value === "string" && value.trim() !== "" ? value.trim() : null;
  }

  function asn(value: unknown): number | null {
    const parsed = typeof value === "string" ? Number(value.replace(/^AS/i, "")) : value;
    return typeof parsed === "number" && Number.isInteger(parsed) && parsed > 0 ? parsed : null;
  }

  async function lookupGeo(): Promise<Geo | null> {
    // 1つめ: 都道府県番号(region_code)と市区町村まで返る
    try {
      const response = await fetch("https://ipwho.is/", { referrerPolicy: "no-referrer", signal: AbortSignal.timeout(5000) });
      const data = await response.json();
      if (data && data.success !== false) {
        return {
          country: text(data.country),
          country_code: text(data.country_code),
          region: text(data.region),
          region_code: text(data.region_code),
          city: text(data.city),
          network: text(data.connection?.org) ?? text(data.connection?.isp),
          asn: asn(data.connection?.asn),
        };
      }
    } catch {
      /* 次の候補へ */
    }

    // 2つめ: ipwho.is が落ちている / 上限に達したときの控え
    try {
      const response = await fetch("https://get.geojs.io/v1/ip/geo.json", {
        referrerPolicy: "no-referrer",
        signal: AbortSignal.timeout(5000),
      });
      const data = await response.json();
      return {
        country: text(data.country),
        country_code: text(data.country_code),
        region: text(data.region),
        region_code: null,
        city: text(data.city),
        network: text(data.organization_name),
        asn: asn(data.asn),
      };
    } catch {
      return null;
    }
  }

  /** 外部サイトから来たときだけ、そのドメイン名を返す(パスやクエリは捨てる) */
  function referrerHost(): string | null {
    if (!document.referrer) return null;
    try {
      const host = new URL(document.referrer).hostname.toLowerCase();
      return host && host !== location.hostname ? host : null;
    } catch {
      return null;
    }
  }

  /** User-Agent から種類だけを取り出す。原文は送らない。 */
  function describeClient(): Client {
    const ua = navigator.userAgent;
    const nav = navigator as Navigator & { userAgentData?: { mobile?: boolean } };
    const touchMac = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1; // iPadOS
    const device: Client["device"] =
      touchMac || /iPad|Tablet/.test(ua) || (/Android/.test(ua) && !/Mobile/.test(ua))
        ? "tablet"
        : nav.userAgentData?.mobile || /Mobi|iPhone|iPod|Android/.test(ua)
          ? "mobile"
          : "desktop";
    const browser = /Edg\//.test(ua)
      ? "Edge"
      : /OPR\//.test(ua)
        ? "Opera"
        : /SamsungBrowser\//.test(ua)
          ? "Samsung Internet"
          : /Firefox\/|FxiOS/.test(ua)
            ? "Firefox"
            : /Chrome\/|CriOS/.test(ua)
              ? "Chrome"
              : /Safari\//.test(ua)
                ? "Safari"
                : "その他";
    const os = touchMac || /iPhone|iPad|iPod/.test(ua)
      ? "iOS"
      : /Android/.test(ua)
        ? "Android"
        : /Windows/.test(ua)
          ? "Windows"
          : /CrOS/.test(ua)
            ? "ChromeOS"
            : /Mac OS X|Macintosh/.test(ua)
              ? "macOS"
              : /Linux/.test(ua)
                ? "Linux"
                : "その他";
    return { device, browser, os };
  }

  /**
   * セッション最初のページかどうかと、以前の別セッションでも来ていたか。
   * ブラウザの保存領域が使えないときは判定できないので null を返す。
   */
  function sessionInfo(): { landing: boolean | null; returning: boolean | null } {
    const current = readStorage("session", SESSION_KEY);
    if (current) return { landing: false, returning: current === "returning" };

    const lastSeen = readStorage("local", LAST_SEEN_KEY);
    const kind = lastSeen ? "returning" : "new";
    writeStorage("session", SESSION_KEY, kind);
    writeStorage("local", LAST_SEEN_KEY, String(Date.now()));
    if (readStorage("session", SESSION_KEY) !== kind) return { landing: null, returning: null };
    return { landing: true, returning: kind === "returning" };
  }

  // 滞在時間: 画面が表示されていた時間だけを数え、タブを離れたときに送る
  let visitToken: string | null = null;
  let visibleMs = 0;
  let visibleSince: number | null = document.visibilityState === "visible" ? performance.now() : null;

  function sendDuration(): void {
    if (visibleSince !== null) {
      visibleMs += performance.now() - visibleSince;
      visibleSince = null;
    }
    if (!visitToken || !SUPABASE_URL || !SUPABASE_KEY) return;
    try {
      void fetch(`${SUPABASE_URL}/rest/v1/rpc/update_site_visit_duration`, {
        method: "POST",
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: `Bearer ${SUPABASE_KEY}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ p_visit_token: visitToken, p_seconds: Math.round(visibleMs / 1000) }),
        keepalive: true,
      }).catch(() => undefined);
    } catch {
      /* 送れなくても表示には影響させない */
    }
  }

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "hidden") sendDuration();
    else if (visibleSince === null) visibleSince = performance.now();
  });
  window.addEventListener("pagehide", sendDuration);

  async function record(): Promise<void> {
    if (!SUPABASE_URL || !SUPABASE_KEY) return;
    if (optedOut()) return;
    if (LOCAL_HOSTS.has(location.hostname)) return;

    const path = location.pathname;
    // 管理ページ自身は数えない
    if (path.startsWith("/visits")) return;

    // 同じセッション中の同じページは1回だけ数える
    const seenKey = `visit-logged:${path}`;
    if (readStorage("session", seenKey)) return;
    writeStorage("session", seenKey, "1");

    const session = sessionInfo();
    const client = describeClient();

    let geo = cachedGeo();
    if (!geo) {
      geo = await lookupGeo();
      if (geo) {
        writeStorage("local", GEO_CACHE_KEY, JSON.stringify({ at: Date.now(), geo }));
      }
    }

    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/rpc/record_site_visit`, {
        method: "POST",
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: `Bearer ${SUPABASE_KEY}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          p_page_path: path,
          p_country: geo?.country ?? null,
          p_country_code: geo?.country_code ?? null,
          p_region: geo?.region ?? null,
          p_region_code: geo?.region_code ?? null,
          p_city: geo?.city ?? null,
          p_client_key: clientKey(),
          p_referrer_host: referrerHost(),
          p_device: client.device,
          p_browser: client.browser,
          p_os: client.os,
          p_language: navigator.language || null,
          p_network: geo?.network ?? null,
          p_asn: geo?.asn ?? null,
          p_is_landing: session.landing,
          p_is_returning: session.returning,
        }),
        keepalive: true,
      });
      if (response.ok) {
        const token: unknown = await response.json();
        if (typeof token === "string") visitToken = token;
      }
    } catch {
      /* 記録できなくてもページの表示には影響させない */
    }
  }

  // 表示を邪魔しないよう、描画が落ち着いてから送る
  const start = () => {
    const idleWindow = window as Window & {
      requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number;
    };
    if (typeof idleWindow.requestIdleCallback === "function") {
      idleWindow.requestIdleCallback(() => void record(), { timeout: 4000 });
    } else {
      window.setTimeout(() => void record(), 1200);
    }
  };

  if (document.readyState === "complete") start();
  else window.addEventListener("load", start, { once: true });
</script>
