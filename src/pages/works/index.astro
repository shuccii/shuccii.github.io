---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getWorkImage } from "../../lib/media";

const works = (await getCollection("works")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = (d: Date) => `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}`;

// 本文が書かれているものだけ詳細ページを持つ(/works/[slug]/ と同じ条件)
const items = works.map((work) => ({
  ...work,
  hasDetail: (work.body ?? "").trim().length > 0,
  thumbnail: getWorkImage(work.data.image),
}));

const groups = [
  {
    key: "publication",
    en: "Publications",
    ja: "出版物・発表",
    desc: "論文、学会発表、寄稿した記事など。",
  },
  {
    key: "app",
    en: "Apps",
    ja: "アプリ・ツール",
    desc: "研究や日々の作業のために作ったアプリ・ツール。",
  },
  {
    key: "site",
    en: "Sites",
    ja: "Webサイト",
    desc: "制作したWebサイト。",
  },
].map((group) => ({
  ...group,
  items: items.filter((work) => work.data.type === group.key),
}));

---

<Layout
  title="作ったもの | Shuichi Tani"
  description="谷 周一が作成した出版物・アプリ・Webサイトの一覧"
>
  <h1><span class="en">Works</span>作ったもの</h1>

  <p class="lead">
    書いたもの、作ったものを置いています。出版物・発表、アプリ・ツール、Webサイトの順に、新しいものから並べています。
  </p>

  {
    items.length === 0 ? (
      <div class="empty glass">
        <p>まだ登録がありません。追加するには2つの方法があります。</p>
        <ol>
          <li>公開サイトのこのページで「✎ 編集」を押し、下のフォームから登録する</li>
          <li>
            <code>src/content/works/</code> にMarkdownファイルを置く
          </li>
        </ol>
      </div>
    ) : (
      groups
        .filter((group) => group.items.length > 0)
        .map((group) => (
          <section class="group">
            <h2>
              <span class="en">{group.en}</span>
              {group.ja}
            </h2>
            <p class="group-desc">{group.desc}</p>
            <ul class="works">
              {group.items.map((work) => (
                <li class="glass">
                  {work.thumbnail && (
                    <span class="thumb">
                      <Image
                        src={work.thumbnail}
                        alt={`${work.data.title}のサムネイル`}
                        width={480}
                        loading="lazy"
                      />
                    </span>
                  )}
                  <div class="work-body">
                    <p class="work-head">
                      <time datetime={work.data.date.toISOString().slice(0, 10)}>
                        {fmt(work.data.date)}
                      </time>
                    </p>
                    <h3>
                      {work.hasDetail ? (
                        <a href={`/works/${work.id}/`}>{work.data.title}</a>
                      ) : work.data.url ? (
                        <a
                          href={work.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {work.data.title} ↗
                        </a>
                      ) : (
                        work.data.title
                      )}
                    </h3>
                    {work.data.venue && <p class="venue">{work.data.venue}</p>}
                    {work.data.description && (
                      <p class="desc">{work.data.description}</p>
                    )}
                    {work.data.tech.length > 0 && (
                      <p class="tech">{work.data.tech.join(" / ")}</p>
                    )}
                    <p class="links">
                      {work.hasDetail && (
                        <a href={`/works/${work.id}/`}>詳しく見る →</a>
                      )}
                      {work.data.url && (
                        <a
                          href={work.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {work.data.type === "publication"
                            ? "本文・DOI ↗"
                            : "公開ページ ↗"}
                        </a>
                      )}
                      {work.data.repo && (
                        <a
                          href={work.data.repo}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          ソースコード ↗
                        </a>
                      )}
                    </p>
                    {work.data.tags.length > 0 && (
                      <p class="tags">
                        {work.data.tags.map((tag) => (
                          <a
                            class="tag"
                            href={`/search/?q=${encodeURIComponent(tag)}`}
                          >
                            {tag}
                          </a>
                        ))}
                      </p>
                    )}
                    <p
                      class="work-controls"
                      aria-label={`「${work.data.title}」の編集操作`}
                    >
                      <button
                        type="button"
                        class="work-edit"
                        data-work-path={`src/content/works/${work.id}.md`}
                      >
                        編集
                      </button>
                      <button
                        type="button"
                        class="blog-delete"
                        data-delete-label="この項目を削除しますか？"
                        data-blog-path={`src/content/works/${work.id}.md`}
                      >
                        削除
                      </button>
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
    )
  }
</Layout>

<style>
  .lead {
    font-size: 1.02rem;
    max-width: 38em;
    margin-bottom: 1rem;
  }

  .group-desc {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin-top: -0.9rem;
    margin-bottom: 1.2rem;
  }

  .works {
    list-style: none;
    padding: 0;
  }

  .works li {
    --glass-radius: 16px;
    display: flex;
    gap: 1.25rem;
    padding: 1.1rem 1.15rem;
    margin-bottom: 0.8rem;
  }

  .thumb {
    flex: 0 0 clamp(6rem, 18vw, 10rem);
  }

  .thumb :global(img) {
    width: 100%;
    height: auto;
    border-radius: 10px;
    display: block;
  }

  .work-body {
    min-width: 0;
    flex: 1;
  }

  .work-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.25rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .works h3 {
    margin: 0;
    font-size: 1.02rem;
  }

  .venue {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .desc {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .tech {
    margin: 0.35rem 0 0;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 0.55rem 0 0;
    font-size: 0.86rem;
  }

  .tags {
    margin: 0.5rem 0 0;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .empty {
    --glass-radius: 14px;
    color: var(--surface-muted);
    padding: 1.5rem;
  }

  .empty ol {
    margin-bottom: 0;
    padding-left: 1.2rem;
  }

  .work-controls {
    display: none;
    gap: 0.5rem;
    margin: 0.65rem 0 0;
  }

  :global(body.editing) .work-controls {
    display: flex;
  }

  .work-controls button {
    border: 1px solid var(--floating-border);
    border-radius: 4px;
    padding: 0.2rem 0.6rem;
    color: var(--floating-text);
    background: var(--floating-bg);
    font: inherit;
    font-size: 0.76rem;
    cursor: pointer;
  }

  .work-controls .blog-delete {
    color: #b42318;
  }

  @media (max-width: 680px) {
    .works li {
      flex-direction: column;
      gap: 0.8rem;
    }

    .thumb {
      flex: none;
      max-width: 14rem;
    }
  }
</style>
