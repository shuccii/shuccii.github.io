---
import Layout from "../layouts/Layout.astro";

// GitHub Pages は存在しないURLに対してこのページを返す。
const links = [
  { href: "/", label: "トップへ戻る" },
  { href: "/blog/", label: "日記を読む" },
  { href: "/search/", label: "サイト内を検索する" },
];
---

<Layout
  title="ページが見つかりません | Shuichi Tani"
  description="お探しのページは見つかりませんでした。"
>
  <h1><span class="en">Not Found</span>ページが見つかりません</h1>

  <div class="empty glass">
    <p class="code">404</p>
    <p>
      お探しのページは、移動したか削除されたようです。
      URLの入力間違いでなければ、下のリンクから探してみてください。
    </p>
    <ul class="links">
      {links.map(({ href, label }) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .empty {
    padding: 2rem 1.75rem;
    text-align: center;
  }

  .code {
    margin: 0 0 0.75rem;
    font-family: "Times New Roman", Georgia, serif;
    font-size: 3.2rem;
    line-height: 1;
    letter-spacing: 0.08em;
    opacity: 0.55;
  }

  .links {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.4rem;
  }

  .links a {
    font-size: 0.9rem;
  }
</style>
